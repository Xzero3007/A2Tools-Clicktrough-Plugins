--- a/plugins/event-timers/plugin.js
+++ b/plugins/event-timers/plugin.js
@@ -37,6 +37,10 @@ const els = {
     settings: $(".view.settings"),
   },
   events: $(".eventList"),
+  foldedBossHead: $(".foldedBossHead"),
+  foldedBoss: $(".foldedBossList"),
