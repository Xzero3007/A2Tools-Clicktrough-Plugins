       <label class="setting"><span class="scaleLabel">Text size</span> <select class="scaleSelect"></select></label>
+      <label class="setting"><span class="foldedBossLabel">Folded: bosses due within</span> <select class="foldedBossSelect"></select></label>
     </section>
     <div class="modal" role="dialog" aria-modal="true" hidden>
       <div class="modalBox">
diff --git a/plugins/event-timers/plugin.js b/plugins/event-timers/plugin.js
index 8a62bdf..c1d612a 100644
--- a/plugins/event-timers/plugin.js
+++ b/plugins/event-timers/plugin.js
@@ -38,6 +38,10 @@ const els = {
   },
   events: $(".eventList"),
   eventsHead: $(".eventsHead"),
+  foldedBossHead: $(".foldedBossHead"),
+  foldedBoss: $(".foldedBossList"),
+  foldedBossLabel: $(".foldedBossLabel"),
+  foldedBossSelect: $(".foldedBossSelect"),
   hidden: $(".hidden"),
   scheduledHead: $(".scheduledHead"),
   scheduled: $(".scheduledList"),
@@ -119,6 +123,13 @@ const ALERT_COLORS = {
 // Text size: the whole page scaled, spacing and controls with the text.
 // 100% is BASE_ZOOM, a little larger than the stylesheet's own sizes.
 const SCALES = [0.9, 1, 1.1, 1.25, 1.5];
+// Folded, the bosses up now or due within this many minutes show under the
+// next events; 0 shows none.
+const FOLDED_BOSS_MINUTES = [0, 30, 60, 120, 180];
+const DEFAULT_FOLDED_BOSS_MINUTES = 60;
+// Events the folded view keeps however far off they are: the next Artifact
+// Siege, three times a week, is past the next three events most of the time.
+const FOLDED_ALWAYS = new Set(["artifact"]);
 const BASE_ZOOM = 1.2;
 // The feed of world boss timers: read this often, or every FEED_BUSY_MS
 // while a world boss on the server is up, due within 15 minutes or overdue,
@@ -347,6 +358,24 @@ const MORE_UI = {
         bossSoon: (name, n) => `${name} ${n} 分钟后出现`, bossNow: (name) => `${name} 已出现` },
 };
 
+// The words for the folded view's bosses.
+const FOLDED_UI = {
+  en: { foldedBosses: "Folded: bosses due within" },
+  ko: { foldedBosses: "접었을 때: 이 시간 안의 보스" },
+  ja: { foldedBosses: "折りたたみ時：この時間内のボス" },
+  de: { foldedBosses: "Eingeklappt: Bosse der nächsten" },
+  fr: { foldedBosses: "Replié : boss dans les prochaines" },
+  es: { foldedBosses: "Plegado: jefes en las próximas" },
+  pt: { foldedBosses: "Recolhido: chefes nas próximas" },
+  ru: { foldedBosses: "В свёрнутом виде: боссы в ближайшие" },
+  "zh-Hant": { foldedBosses: "收合時：顯示此時間內的首領" },
+  "zh-Hans": { foldedBosses: "折叠时：显示此时间内的首领" },
+};
+const foldedWords = () => FOLDED_UI[language] || FOLDED_UI.en;
+const foldedMinutes = () =>
+  FOLDED_BOSS_MINUTES.includes(prefs.foldedBossMinutes) ? prefs.foldedBossMinutes : DEFAULT_FOLDED_BOSS_MINUTES;
+const minutesText = (m) => (m < 60 ? `${m} min` : `${m / 60} h`);
+
 // The Bosses tab's row buttons: each boss's alert on or off, and the way to
 // its settings in Alerts.
 const ROW_UI = {
@@ -429,7 +458,7 @@ let gameRunning = null;
 // voiceRate.
 let prefs = { region: "auto", hidden: [], alerts: {}, leads: {}, closedLeads: {}, sound: "chime", repeat: 1, volume: 100, pop: false,
   tab: "events", display: "system", lastServer: 0, scale: 1, defaultLead: DEFAULT_LEAD, defaultClosedLead: DEFAULT_CLOSED_LEAD,
-  alertColor: "orange", alsoAtStart: false, folded: {}, speak: false, voiceName: "", voiceType: "any", voiceRate: 1 };
+  alertColor: "orange", alsoAtStart: false, folded: {}, speak: false, voiceName: "", voiceType: "any", voiceRate: 1, foldedBossMinutes: DEFAULT_FOLDED_BOSS_MINUTES };
 // The world boss timers: { server, bosses, at, error }, from the feed and the
 // player's own map, the newest report of each boss kept.
 let feed = null;
@@ -751,6 +780,9 @@ function renderStatic() {
   els.defaultClosed.value = String(defaultClosed());
   els.scaleSelect.replaceChildren(...SCALES.map((x) => option(x, `${Math.round(x * 100)}%`)));
   els.scaleSelect.value = String(prefs.scale);
+  els.foldedBossLabel.textContent = foldedWords().foldedBosses;
+  els.foldedBossSelect.replaceChildren(...FOLDED_BOSS_MINUTES.map((m) => option(m, m ? minutesText(m) : a.off)));
+  els.foldedBossSelect.value = String(foldedMinutes());
   els.soundLabel.textContent = a.sound;
   els.testAlert.textContent = words.testAlert;
   els.alertOptionsBtn.textContent = words.alertOptions;
@@ -1096,12 +1128,14 @@ function renderSchedule(list, events, now, { hideable, actions = false }) {
         render();
       });
     }
-    return row({
+    const li = row({
       id: ev.id, name: eventName(ev), where: ev.where.map(text).join(", "), running, hide, actions,
       soon: next.start - now <= SOON_MS,
       countdown: running ? `${ev.enter ? enterWord() : words.now} · ${words.left(span(next.end - now))}` : words.in(span(next.start - now)),
       at: fmt.format(new Date(next.start)),
     });
+    li.classList.toggle("keepFolded", FOLDED_ALWAYS.has(ev.id));
+    return li;
   }));
   return shown;
 }
@@ -1194,10 +1228,56 @@ function fieldItems(bosses, now, withHeads) {
   return items;
 }
 
+// Folded: under the next events, the world bosses up, in their window or
+// back within the chosen time (the Abyss's scheduled bosses among them, as
+// 0.6.23 lists them: up while their spawn is on); the ones up first, then by
+// time. Rows as on the Bosses tab, a bell where an alert is on, without its
+// buttons.
+function renderFoldedBosses(now) {
+  const minutes = foldedMinutes();
+  if (!document.body.classList.contains("compact") || !minutes) {
+    els.foldedBoss.replaceChildren();
+    els.foldedBossHead.hidden = true;
+    return;
+  }
+  const limit = minutes * 60_000;
+  const words = ui();
+  const fmt = clock();
+  const items = [];
+  for (const b of fieldBosses()) {
+    const t = fieldTimer(b.id);
+    const next = t?.state === "dead" && t.nextSpawn ? t.nextSpawn * 1000 : null;
+    const up = t?.state === "up";
+    const inWindow = !up && !!next && next <= now && now - next <= WINDOW_MS;
+    if (!up && !inWindow && !(next && next > now && next - now <= limit)) continue;
+    let countdown;
+    let at;
+    if (up) {
+      countdown = t.upSince ? words.upFor(span(now - t.upSince * 1000)) : words.up;
+      at = t.hp != null && t.hpAt
+        ? `${words.hpLeft(t.hp)} · ${words.ago(age(now - t.hpAt * 1000))}`
+        : words.seen(age(now - (t.reportedAt || 0) * 1000));
+    } else {
+      countdown = inWindow ? words.ago(age(now - next)) : words.in(span(next - now));
+      at = fmt.format(new Date(next));
+    }
+    const name = text(b.name) + (b.level ? ` · Lv ${b.level}` : "");
+    const li = row({ id: `field:${b.id}`, name, where: text(b.where), countdown, at, up, soon: inWindow || next - now <= SOON_MS });
+    if (up && t.hp != null && t.hpAt) li.style.setProperty("--hp", `${Math.max(0, Math.min(100, t.hp))}%`);
+    li.classList.toggle("hasHp", up && t.hp != null && !!t.hpAt);
+    items.push({ first: up || inWindow, at: up ? 0 : next, li });
+  }
+  items.sort((x, y) => Number(y.first) - Number(x.first) || x.at - y.at);
+  els.foldedBoss.replaceChildren(...items.map((x) => x.li));
+  els.foldedBossHead.textContent = `${words.bosses} · ≤ ${minutesText(minutes)}`;
+  els.foldedBossHead.hidden = !items.length;
+}
+
 function render() {
   const now = Date.now();
   renderHeader(now);
   renderHidden(renderSchedule(els.events, scheduled("event"), now, { hideable: true }));
+  renderFoldedBosses(now);
   // Not while a row's button is pressed; a focused one keeps its focus.
   if (rowPress) return;
   const focused = document.activeElement?.closest?.(".rowBtn");
@@ -2103,6 +2183,11 @@ els.scaleSelect.addEventListener("change", () => {
   savePrefs();
   applyScale();
 });
+els.foldedBossSelect.addEventListener("change", () => {
+  prefs.foldedBossMinutes = Number(els.foldedBossSelect.value);
+  savePrefs();
+  render();
+});
 els.regionSelect.addEventListener("change", () => {
   prefs.region = els.regionSelect.value;
   savePrefs();
@@ -2141,7 +2226,10 @@ a2.on("bossMap", (m) => {
 a2.on("game", (g) => {
   gameRunning = typeof g?.running === "boolean" ? g.running : null;
 });
-a2.on("compact", (on) => document.body.classList.toggle("compact", !!on));
+a2.on("compact", (on) => {
+  document.body.classList.toggle("compact", !!on);
+  render();
+});
 
 (async () => {
   prefs = { ...prefs, ...((await a2.storage.get("prefs").catch(() => null)) || {}) };
