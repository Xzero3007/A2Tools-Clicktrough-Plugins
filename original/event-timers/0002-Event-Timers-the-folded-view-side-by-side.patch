diff --git a/plugins/event-timers/style.css b/plugins/event-timers/style.css
index fdfbf65..fb4233f 100644
--- a/plugins/event-timers/style.css
+++ b/plugins/event-timers/style.css
@@ -43,6 +43,65 @@ body.compact .eventList li.keepFolded {
   display: grid;
 }
 
+/* Folded: a heading over the events with the layout button, and (side by
+   side) the later bosses in a column of their own. */
+.foldedEventsHead,
+.foldedLaterHead,
+.foldedLaterList {
+  display: none;
+}
+body.compact .foldedEventsHead {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  margin-top: 0;
+}
+body.compact .foldedLaterHead:not([hidden]),
+body.compact .foldedLaterList {
+  display: block;
+}
+.foldedLayoutBtn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 22px;
+  height: 20px;
+  padding: 0;
+  border: 1px solid rgba(255, 255, 255, 0.12);
+  border-radius: 5px;
+  background: transparent;
+  color: rgba(255, 255, 255, 0.55);
+  cursor: pointer;
+}
+.foldedLayoutBtn:hover,
+.foldedLayoutBtn:focus-visible {
+  color: rgba(255, 255, 255, 0.9);
+  border-color: rgba(255, 255, 255, 0.3);
+}
+.foldedLayoutBtn[aria-pressed="true"] {
+  color: rgba(255, 255, 255, 0.9);
+  border-color: rgba(255, 255, 255, 0.35);
+}
+/* Side by side: a wide bar, a column each (events, bosses now and soon,
+   later bosses). Too narrow for that, they wrap under each other. */
+body.compact.foldedColumns .view.events {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
+  gap: 10px 20px;
+  align-items: start;
+}
+body.compact.foldedColumns .view.events > .siege {
+  grid-column: 1 / -1;
+}
+body.compact.foldedColumns .foldedCol[hidden] {
+  display: none;
+}
+body.compact.foldedColumns .foldedBossHead,
+body.compact.foldedColumns .foldedLaterHead {
+  margin-top: 0;
+}
+
 .status {
   color: rgba(255, 255, 255, 0.55);
   font-size: 12px;
-- 
