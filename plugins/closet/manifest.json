{
  "id": "closet",
  "name": "Closet",
  "version": "0.2.15",
  "apiVersion": 2,
  "author": "Clicktrough (skin names, grades and icons: the game client via SkeeveAN's Aion-DPS-Meter, MIT, and Aion2Data)",
  "description": "Your skins against the 700 of the title Empty Closet: the Black Cloud Merchant's offers of every character marked new or owned, one window over the game when you open the shop (the skins on offer with pictures, characters not looked at, what to combine), every skin you still lack with its picture and price, what the rest costs, and what to combine and extract and what no longer pays.",
  "permissions": [
    "storage",
    "notify",
    "widgets",
    "share",
    "events:character",
    "events:items",
    "events:world",
    "web:assets.playnccdn.com",
    "web:raw.githubusercontent.com",
    "decoder:closet-list",
    "decoder:closet-add",
    "decoder:shop",
    "decoder:shop-open"
  ],
  "decoders": [
    {
      "name": "closet-list",
      "opcode": "5B 8D",
      "fields": [
        {
          "name": "looks",
          "type": "list",
          "count": "varint",
          "fields": [
            {
              "name": "id",
              "type": "u32"
            },
            {
              "name": "value",
              "type": "u32"
            }
          ]
        }
      ]
    },
    {
      "name": "closet-add",
      "opcode": "5C 8D",
      "immediate": true,
      "fields": [
        {
          "name": "looks",
          "type": "list",
          "count": "u8",
          "fields": [
            {
              "name": "id",
              "type": "u32"
            },
            {
              "name": "value",
              "type": "u32"
            }
          ]
        }
      ]
    },
    {
      "name": "shop",
      "opcode": "91 56",
      "immediate": true,
      "fields": [
        {
          "name": "tab",
          "type": "u8"
        },
        {
          "name": "count",
          "type": "u8"
        },
        {
          "name": "body",
          "type": "rest"
        }
      ]
    },
    {
      "name": "shop-open",
      "opcode": "61 E2",
      "immediate": true,
      "fields": [
        {
          "name": "a",
          "type": "u16"
        }
      ]
    }
  ],
  "ui": {
    "panel": {
      "width": 600,
      "height": 660
    },
    "overlay": {
      "widget": "status",
      "title": "Closet",
      "icon": "shirt"
    }
  }
}
